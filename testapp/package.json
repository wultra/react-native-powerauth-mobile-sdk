{
  "name": "testapp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "npx react-native run-android",
    "ios": "npx react-native run-ios",
    "start": "npx react-native start",
    "pods": "pushd ios; pod install; popd",
    "rebuildPlugin": "pushd .. && gulp rn && popd",
    "reinstallPlugin": "(npm r react-native-powerauth-mobile-sdk || true) && npm run rebuildPlugin && npm i ../build/react-native/$(pushd ../build/react-native/ > /dev/null && ls | grep .tgz) --save",
    "freshAndroid": "npm run reinstallPlugin && npm run android",
    "freshIos": "npm run reinstallPlugin && npm run pods && npm run ios"
  },
  "dependencies": {
    "powerauth-js-test-client": "^0.2.14",
    "react": "19.0.0",
    "react-native": "0.78.0",
    "react-native-config": "^1.5.0",
    "react-native-powerauth-mobile-sdk": "file:../build/react-native/react-native-powerauth-mobile-sdk-3.0.0.tgz"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.78.0",
    "@react-native/eslint-config": "0.78.0",
    "@react-native/metro-config": "0.78.0",
    "@react-native/typescript-config": "0.78.0",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "eslint": "^8.19.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.0.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
