{
  "name": "testapp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prepare:powerauth": "yarn workspace react-native-powerauth-mobile-sdk run stage",
    "android": "yarn prepare:powerauth && react-native run-android",
    "android:prepared": "react-native run-android",
    "ios": "yarn prepare:powerauth && react-native run-ios",
    "ios:prepared": "react-native run-ios",
    "start": "yarn prepare:powerauth && react-native start",
    "start:prepared": "react-native start",
    "pods": "yarn prepare:powerauth && (cd ios && yarn dlx pod-install --non-interactive)",
    "buildAndroid": "yarn prepare:powerauth && (cd android && ./gradlew assemble)",
    "buildIos": "yarn pods && (cd ios && xcodebuild archive -workspace testapp.xcworkspace -scheme testapp -sdk iphoneos CODE_SIGN_IDENTITY=\"\" CODE_SIGNING_ALLOWED=NO)",
    "freshAndroid": "yarn android",
    "freshIos": "yarn pods && yarn ios",
    "lint": "eslint .",
    "format": "prettier -w ."
  },
  "dependencies": {
    "mobile-test-reporter": "workspace:*",
    "mobile-testbed": "workspace:*",
    "react": "19.1.1",
    "react-native": "0.82.1",
    "react-native-config": "1.5.5",
    "react-native-powerauth-mobile-sdk": "workspace:*",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.82.1",
    "@react-native/eslint-config": "0.82.1",
    "@react-native/eslint-plugin": "0.82.1",
    "@react-native/metro-config": "0.82.1",
    "@react-native/typescript-config": "0.82.1",
    "@types/react": "^19.1.1",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "react-test-renderer": "19.1.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
