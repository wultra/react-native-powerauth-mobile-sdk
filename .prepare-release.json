{
    "metadata": {
        "purpose": "This file is used as a definition file for the prepare-release script.",
        "info": "It defines files that contains version number that should be updated during the release preparation.",
        "customBuildscript": "If needed, in the library object, set \"buildscript\": \"your-custom-build-command\" command if your build command is different than 'npm i && npm run build'"
    },
    "library": {
        "name": "react-native-powerauth-mobile-sdk",
        "type": "yarn",
        "artifacts": [
            "packages/lib-cordova/build/cdv/cordova-powerauth-mobile-sdk-%VERSION%.tgz",
            "packages/lib-rn/build/rn/react-native-powerauth-mobile-sdk-%VERSION%.tgz"
        ],
        "buildscript": "corepack enable && yarn install && yarn packAll"
    },
    "scriptVersion": 2,
    "devVersion": "0.0.1-dev",
    "files": [
        {
            "description": "Package definition files.",
            "paths": ["packages/react-native-powerauth-mobile-sdk/package.json", "package.json"],
            "type": "version_replace",
            "match": "\"version\": \"%VERSION%\",\n",
            "devChange": true
        },
        {
            "description": "Cordova package definition file.",
            "path": "packages/lib-cordova/package.json",
            "type": "version_replace",
            "match": "\"version\": \"%VERSION%\",\n"
        },
        {
            "description": "Cordova plugin definition file.",
            "path": "packages/lib-cordova/plugin.xml",
            "type": "version_replace",
            "match": "id=\"cordova-powerauth-mobile-sdk\" version=\"%VERSION%\""
        },
        {
            "description": "Changelog for the Wultra documentation.",
            "path": "docs/Changelog.md",
            "type": "tba_replace",
            "match": "## TBA",
            "devChangelog": true
        },
        {
            "description": "Verify that the changelog does not contain a TBA placeholder.",
            "path": "docs/Changelog.md",
            "type": "verify_not_containing",
            "match": "- TBA"
        }
    ]
}