    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "mobile-testbed": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
