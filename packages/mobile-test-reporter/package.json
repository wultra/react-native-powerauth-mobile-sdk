{
  "name": "mobile-test-reporter",
  "version": "0.0.0",
  "private": true,
  "description": "Reporter package for sending on-device test events to a HTTP-based collector.",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "src/index",
  "source": "src",
