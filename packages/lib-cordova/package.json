{
  "name": "cordova-powerauth-mobile-sdk",
  "title": "PowerAuth Mobile JS SDK for Cordova Mobile Apps",
  "version": "0.0.1-dev",
  "description": "Wultra PowerAuth Mobile JS SDK for Cordova (iOS and Android)",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "type": "commonjs",
  "files": [
    "README.md",
    "android/src/main/AndroidManifest.xml",
    "android/src/main/java/com/wultra/android/powerauth/cdv/*",
    "android/src/main/java/com/wultra/android/powerauth/bridge/*",
    "android/src/main/java/com/wultra/android/powerauth/js/*",
    "android/build.gradle",
    "lib/*",
    "ios/PowerAuth/Info.plist",
    "ios/PowerAuth/*.m",
    "ios/PowerAuth/*.mm",
    "ios/PowerAuth/*.c",
    "ios/PowerAuth/*.h",
    "plugin.xml"
  ],
  "homepage": "https://www.wultra.com/mobile-security-suite",
  "repository": {
    "type": "git",
    "url": "https://github.com/wultra/react-native-powerauth-mobile-sdk.git"
  },
  "keywords": [
    "cordova",
    "powerauth",
    "security"
  ],
  "author": {
    "name": "Wultra s.r.o.",
    "email": "support@wultra.com"
  },
  "license": "Apache 2.0",
  "licenseFilename": "LICENSE",
  "readmeFilename": "README.md",
  "scripts": {
    "build": "node ../../scripts/build.mjs cordova",
    "cdv": "node ../../scripts/build.mjs cordova",
    "pack:tgz": "node ../../scripts/build.mjs cordova --pack"
  }
}
