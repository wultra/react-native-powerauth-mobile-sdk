{
  "name": "mobile-test-runner",
  "version": "0.0.0",
  "private": true,
  "description": "Node-based collector for on-device integration tests",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": "dist/cli.js",
  "source": "src",
  "files": [
    "README.md",
    "src/**/*",
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "mobile-test-reporter": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^6.0.2"
  }
}
