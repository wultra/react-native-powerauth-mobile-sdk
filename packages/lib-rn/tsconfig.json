{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "declaration": false,
    "composite": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": []
  },
  "exclude": ["node_modules", "lib"],
  "include": ["src"]
}
