{
  "name": "react-native-powerauth-mobile-sdk",
  "title": "PowerAuth SDK for React Native Mobile Apps",
  "version": "0.0.1-dev",
  "description": "Wultra PowerAuth Mobile SDK React Native component for iOS and Android",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src",
  "scripts": {
    "build": "npm run generate:sdk-version && bob build && npm run build:types",
    "prepare": "npm run build",
    "build:types": "tsc -p tsconfig.build-types.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "generate:sdk-version": "node scripts/generate-sdk-version.cjs",

    "freshCordovaIos": "pushd testapp-cordova && npm run freshIos",
    "freshCordovaAndroid": "npm run build && pushd testapp-cordova && npm run freshAndroid",

    "freshReactIos": "npm run build && pushd testapp && npm run freshIos && npx pod-install && npm run ios",
    "freshReactAndroid": "npm run build && pushd testapp && npm run freshAndroid",

    "buildReactIos": "pushd testapp && npm run buildIos",
    "buildReactAndroid": "pushd testapp && npm run buildAndroid",

    "buildCordovaIos": "pushd testapp-cordova && npm run buildIos",
    "buildCordovaAndroid": "pushd testapp-cordova && npm run buildAndroid",

    "purge": "node node_modules/gulp/bin/gulp.js purge"
  },
  "files": [
    "README.md",
    "android/src/main/AndroidManifest.xml",
    "android/src/main/java/com/wultra/android/powerauth/bridge/*.*",
    "android/src/main/java/com/wultra/android/powerauth/js/*.*",
    "android/src/main/java/com/wultra/android/powerauth/reactnative/*.*",
    "android/build.gradle",
    "lib/**/*",
    "ios/PowerAuth.xcodeproj/project.pbxproj",
    "ios/PowerAuth/*.m",
    "ios/PowerAuth/*.c",
    "ios/PowerAuth/*.h",
    "react-native-powerauth-mobile-sdk.podspec"
  ],
  "homepage": "https://www.wultra.com/mobile-security-suite",
  "repository": {
    "type": "git",
    "url": "https://github.com/wultra/react-native-powerauth-mobile-sdk.git"
  },
  "keywords": [
    "react-native",
    "powerauth",
    "security"
  ],
  "author": {
    "name": "Wultra s.r.o.",
    "email": "support@wultra.com"
  },
  "license": "Apache 2.0",
  "licenseFilename": "LICENSE",
  "readmeFilename": "README.md",
  "dependencies": {
    "node-fetch": ">=2.6.1"
  },
  "peerDependencies": {
    "react-native": "*"
  },
  "devDependencies": {
    "@react-native/typescript-config": "^0.78.0",
    "@types/react": "^19.0.0",
    "@capacitor/core": "^6.1.2",
    "@react-native-community/cli": "^18.0.0",
    "esbuild": "^0.25.0",
    "gulp": "^5.0.0",
    "gulp-concat": "^2.6.1",
    "gulp-filter": "^9.0.1",
    "gulp-replace": "^1.1.4",
    "gulp-strip-import-export": "^1.0.0",
    "gulp-typescript": "^6.0.0-alpha.1",
    "lodash": "^4.17.21",
    "pod-install": "^0.2.2",
    "react-native-builder-bob": "^0.40.13",
    "react": "19.0.0",
    "react-native": "^0.78.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.4.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      ["module", { "esm": true }],
      "commonjs"
    ]
  }
}
